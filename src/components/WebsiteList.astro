---
import { messages, type Locale } from '../i18n';
import type { Website } from '../lib/directory';
interface Props { locale: Locale; sites: Website[]; headingLevel?: 'h2' | 'h3' }
const { locale, sites, headingLevel: Heading = 'h3' } = Astro.props;
const t = messages(locale);
---
  {/* Listing cards show only the linked name and description. */}
  {sites.length > 0 ? (
    <ul class="directory-list" role="list">{sites.map((site) => (
      <li class="directory-entry">
        <Heading class="directory-entry-title"><a href={site.url} rel="ugc">{site.name}</a></Heading>
        <p>{site.description}</p>
      </li>
    ))}</ul>
  ) : (
    <div class="empty-directory"><div class="little-home" aria-hidden="true">&#8962;</div><div><Heading class="directory-entry-title">{t.directoryEmptyTitle}</Heading><p>{t.directoryEmpty1}<br />{t.directoryEmpty2}</p></div><span class="empty-label">{t.directoryEmptyStatus}</span></div>
  )}
